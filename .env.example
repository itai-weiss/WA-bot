# Admin UI server (bound to localhost only)
HOST=127.0.0.1
PORT=3000

# Timezone shown in the timings UI
TZ=Asia/Jerusalem

# Optional: your own WhatsApp ID (international format, no + sign, with @c.us suffix).
# Reserved for future owner notifications.
# Example: 972501234567@c.us
OWNER_WHATSAPP_ID=

# Password for the admin UI (HTTP Basic auth, any username). Required when HOST
# is not localhost; the server refuses to start without it.
APP_PASSWORD=

# Optional folder for timings, metagroups, attachments and the WhatsApp session.
# Defaults to the app folder.
DATA_DIR=

# Optional override for the Chrome/Edge executable used by WhatsApp Web.
# Auto-detected on Windows; only set this if auto-detect fails.
# Example: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
